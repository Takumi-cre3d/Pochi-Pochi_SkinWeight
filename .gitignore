# ==========================================
# C++ & CMake Build Artifacts
# ==========================================
build/
out/
bin/
*.sln
*.vcxproj
*.vcxproj.*
*.suo
*.user

# ==========================================
# Compiled binaries (C++ extensions)
# ==========================================
# ※ 注意: コンパイル済みの .pyd ファイルは原則Gitに含めません。
# もしチームメンバーにそのまま配布する目的でGitに入れたい場合は、
# このツールの実行ファイルのみ例外として後述のコマンドで強制追加します。
*.pyd
*.so
*.dll
*.lib
*.exp
*.obj
*.pdb

# ==========================================
# Python Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/

# ==========================================
# Maya Test Scenes
# ==========================================
# テスト用に保存したMayaのシーンファイルを除外
*.ma
*.mb

# ==========================================
# IDE & OS specific
# ==========================================
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db